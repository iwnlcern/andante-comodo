---
/**
 * CSS-only hover/focus popover for the post metadata row. A positioned wrapper
 * holds the `trigger` slot and a tooltip card (default slot) that appears on
 * hover and keyboard focus — no JavaScript, so it works with scripting off.
 *
 * The card is decorative (`role="tooltip"`, `aria-hidden`); the accessible text
 * belongs on the trigger's own `aria-label`.
 */
---

<span class="meta-popover">
  <slot name="trigger" />
  <span class="meta-popover-card" role="tooltip" aria-hidden="true">
    <slot />
  </span>
</span>

<style>
  .meta-popover {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* Hidden state is display:none, not visibility:hidden: an absolutely positioned card that
     keeps its layout box widens the page's scrollWidth when its trigger sits near the viewport
     edge (phone widths wrap the meta row, so the AI trigger can land there), producing horizontal
     scroll on the whole page while the card is invisible. The fade-in survives via
     @starting-style; browsers without it simply show the card without the transition. */
  .meta-popover-card {
    position: absolute;
    bottom: calc(100% + 0.45rem);
    left: 50%;
    z-index: 20;
    display: none;
    width: max-content;
    max-width: min(17rem, calc(100vw - 2rem));
    padding: 0.5rem 0.65rem;
    background: rgb(var(--color-surface));
    border: 1px solid rgb(var(--color-border));
    border-radius: 0.375rem;
    box-shadow: var(--shadow-float);
    color: rgb(var(--color-text-primary));
    font-size: var(--note-scale);
    line-height: 1.5;
    text-align: left;
    white-space: normal;
    opacity: 0;
    transform: translate(-50%, 0.25rem);
    transition: opacity 0.15s ease, transform 0.15s ease, display 0.15s;
    transition-behavior: allow-discrete;
    pointer-events: none;
  }

  .meta-popover:hover .meta-popover-card,
  .meta-popover:focus-within .meta-popover-card {
    display: block;
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @starting-style {
    .meta-popover:hover .meta-popover-card,
    .meta-popover:focus-within .meta-popover-card {
      opacity: 0;
      transform: translate(-50%, 0.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .meta-popover-card {
      transition: none;
    }
  }
</style>
