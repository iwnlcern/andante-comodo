---
import BaseHead from '#components/common/BaseHead.astro';
import Header from '#components/common/Header.astro';
import Footer from '#components/common/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  wide?: boolean;
  post?: boolean;
  noindex?: boolean;
  datePublished?: Date;
  dateModified?: Date;
  bodyClass?: string;
}

const { title, description, image, wide = false, post = false, noindex = false, datePublished, dateModified, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en" class={post ? 'no-scrollbar' : undefined}>
  <head>
    <BaseHead title={title} description={description} image={image} post={post} datePublished={datePublished} dateModified={dateModified} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class:list={['flex flex-col min-h-screen', bodyClass]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" tabindex="-1" data-pagefind-body={noindex ? undefined : ''} class={`flex-1 w-full mx-auto px-6 py-12 ${wide ? 'max-w-[96rem]' : post ? 'max-w-[calc(var(--measure)_+_3rem)]' : 'max-w-5xl'}`}>
      <slot />
    </main>
    <Footer />
    <script>
      import { initTheme } from '#scripts/theme.ts';
      initTheme();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    z-index: 100;
    padding: 0.55rem 0.85rem;
    border: 1px solid rgb(var(--color-accent));
    border-radius: 0.375rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-text-primary));
    transform: translateY(calc(-100% - 1rem));
    transition: transform 120ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
